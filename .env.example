# ORCA Environment Configuration
# Project: ORCA - Ocean Reasoning & Coordination Agent (Fetch-A-Thon 3.0)

# Environment
ORCA_ENV=development
ORCA_LOG_LEVEL=INFO

# Operational Data Sources
INCOIS_BASE_URL=https://www.incois.gov.in
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=

# Fetch Ecosystem / Agentverse
AGENTVERSE_API_KEY=
AGENTVERSE_MAILBOX_KEY=
ACP_ENDPOINT=

# LLM / Reasoning Provider (Model-Agnostic)
LLM_PROVIDER=asi1
LLM_API_KEY=
LLM_MODEL=asi1-mini

# Geospatial Settings
DEFAULT_SEARCH_RADIUS_KM=30.0
MAX_SEARCH_RADIUS_KM=100.0
RESTRICTED_ZONE_BUFFER_KM=5.0
